{
  "name": "venda-saas",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS de vendas multiempresa com PDV e comprovante não fiscal (Node.js + Supabase + Render)",
  "main": "server/index.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm ci --include=dev --prefix client && npm run build --prefix client",
    "db:init": "node server/migrate.js",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
