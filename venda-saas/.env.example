# Supabase: botão "Connect" > "Session pooler" (funciona no Render, que só tem IPv4).
# Troque [SENHA] pela senha do banco (se tiver caracteres especiais, codifique como URL).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Segredo do login. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"


# Opcionais
# PORT=3000
# TZ_EMPRESA=America/Sao_Paulo
# DATABASE_SSL=false
